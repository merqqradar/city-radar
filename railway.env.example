# Токены и переменные для деплоя на Railway.
# Скопируйте этот файл в railway.env и заполните значения.
# railway.env в git не попадает (см. .gitignore) — храните его так же
# бережно, как .env: токен Railway даёт доступ к управлению проектом.

# Личный API-токен Railway (Railway → Account Settings → Tokens)
RAILWAY_TOKEN=
