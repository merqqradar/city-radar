# Скопируйте этот файл в .env и заполните значения.
# .env в git не попадает (см. .gitignore).

# my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Телефон второго аккаунта в международном формате, например +380XXXXXXXXX
TG_PHONE=

# Токен бота от @BotFather (бот должен быть админом канала уведомлений)
BOT_TOKEN=

# ID канала/чата уведомлений: для канала это -100XXXXXXXXXX,
# либо @username публичного канала
TARGET_CHAT_ID=
